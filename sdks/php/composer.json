{
    "name": "cheki/cheki",
    "description": "PHP SDK for cheki, a free Ethiopian receipt verification API: CBE, Telebirr, BOA, M-Pesa, Dashen, Awash, Siinqee, eBirr, ZamZam.",
    "type": "library",
    "homepage": "https://cheki.et",
    "license": "MIT",
    "keywords": [
        "cheki",
        "ethiopia",
        "receipt",
        "verification",
        "banking",
        "payment",
        "sdk",
        "cbe",
        "telebirr",
        "m-pesa",
        "dashen",
        "awash",
        "zemen",
        "eBirr"
    ],
    "authors": [
        {
            "name": "1RB",
            "homepage": "https://cheki.et"
        }
    ],
    "support": {
        "issues": "https://github.com/1RB/cheki/issues",
        "source": "https://github.com/1RB/cheki",
        "docs": "https://cheki.et/docs"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "Cheki\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Cheki\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests examples -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
